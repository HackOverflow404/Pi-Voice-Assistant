#!/usr/bin/env bash
set -euo pipefail
live="$HOME/.local/share/pi-voice-assistant"
unit="$HOME/.config/systemd/user/pi-voice-assistant.service"
echo "Stopping/disabling service and removing $unit, the Echo autostart timer, the WhatsApp bridge, and installed code/runtime under $live."
echo 'Preserving config.yaml, models/, state/ (including the WhatsApp session), and loginctl linger.'
systemctl --user disable --now pi-voice-assistant.service echo-autostart.timer wa-bridge.service 2>/dev/null || true
for name in echo-autostart.service echo-autostart.timer wa-bridge.service; do
  rm -f -- "$(dirname "$unit")/$name"
done
rm -f -- "$unit"
systemctl --user daemon-reload
for name in server scripts systemd bin .venv .bootstrap .python .uv-cache setup.sh config.example.yaml; do
  rm -rf -- "$live/$name"
done
