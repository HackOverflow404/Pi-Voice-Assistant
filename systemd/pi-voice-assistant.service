[Unit]
Description=Pi voice assistant WebSocket server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pi-voice-assistant
Environment=PYTHONPATH=%h/.local/share/pi-voice-assistant/server
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
ExecStart=%h/.local/share/pi-voice-assistant/.venv/bin/python -m voice_assistant.app --config config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/pi-voice-assistant/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
